links:
  # The gear shaft. Distances along a shaft ('moveZ') are measured from its
  # clip-side end.
  - part: motion/shaft_8mmREX_72mm
    name: shaft

  # The E-clip that comes with it, in its groove
  - part: motion/shaft_8mmREX_72mm_clip
    name: shaft-clip
    connect:
      with: 8mmREX-thru-0.7
      withInstance: side1
      name: shaft
      to: 8mmREX-shaft
      toInstance: groove

  - part: motion/hub_sonic_8mmREX
    name: gear-hub
    connect:
      with: 8mmREX-thru-10
      withInstance: ledged
      name: shaft
      to: 8mmREX-shaft
      toInstance: clip-side
      toParams:
        moveZ: 26.5

  - part: motion/worm_gear_28t
    name: gear
    connect:
      with: 4xM4-16mm-pattern-threaded-thru-4mm
      withInstance: inner
      name: gear-hub
      to: 4xM4-16mm-pattern-thru-8mm
      toInstance: ledged

  # Through the hub, into the threads of the gear
  - part: hardware/screw_m4_0.7mm_12mm
    name: hub-screw-TL
    connect:
      withParams:
        moveZ: 8.0
      name: gear
      # TODO(clairbee): Autodetect the interface by the instance name/pattern
      # toInstance: inner-TL*threaded
      to: //pub/std/metric/m:m4-threaded-thru-4
      toInstance: inner-TL

  - part: hardware/screw_m4_0.7mm_12mm
    name: hub-screw-TR
    connect:
      withParams:
        moveZ: 8.0
      name: gear
      to: //pub/std/metric/m:m4-threaded-thru-4
      toInstance: inner-TR

  - part: hardware/screw_m4_0.7mm_12mm
    name: hub-screw-BL
    connect:
      withParams:
        moveZ: 8.0
      name: gear
      to: //pub/std/metric/m:m4-threaded-thru-4
      toInstance: inner-BL

  - part: hardware/screw_m4_0.7mm_12mm
    name: hub-screw-BR
    connect:
      withParams:
        moveZ: 8.0
      name: gear
      to: //pub/std/metric/m:m4-threaded-thru-4
      toInstance: inner-BR

  # Held against the E-clip
  - part: motion/bearing_flanged_8mmREX
    name: bearing-gear-1
    connect:
      with: 8mmREX-thru-5
      withInstance: flange-side
      name: shaft
      to: 8mmREX-shaft
      toInstance: clip

  - part: structure/u_channel_2
    name: channel
    connect:
      with: "//pub/std/metric/m:m14-thru-2.5"
      withInstance: left-outer-0
      # Top up, the way it is drawn
      withParams:
        turnZ: 300
      name: bearing-gear-1
      to: "//pub/std/metric/m:m14-shaft-4"

  # In the other wall of the channel: 48mm further along the shaft than the
  # first one, whose flange is 1mm past the clip
  - part: motion/bearing_flanged_8mmREX
    name: bearing-gear-2
    connect:
      with: 8mmREX-thru-5
      withInstance: clean-side
      name: shaft
      to: 8mmREX-shaft
      toInstance: clip-side
      toParams:
        moveZ: 49

  - part: hardware/spacer_plastic_8mm_1mm
    name: spacer-drive
    connect:
      with: "//pub/std/metric/m:m8-thru-1"
      withInstance: side0
      name: bearing-gear-2
      to: 8mmREX-thru-5
      toInstance: flange-side

  # Its ledge against that spacer, which keeps it clear of the head of the
  # screw holding the mount below it
  - part: motion/hub_sonic_8mmREX
    name: gear-drive-hub
    connect:
      with: 8mmREX-thru-10
      withInstance: ledged
      name: shaft
      to: 8mmREX-shaft
      toInstance: clip-side
      toParams:
        moveZ: 55

  # The worm shaft, through the top of the channel
  # Turned so that the worm, which is keyed to this bearing through its shaft,
  # meshes with the gear
  - part: motion/bearing_flanged_8mmREX
    name: bearing-worm-1
    connect:
      with: "//pub/std/metric/m:m14-shaft-4"
      withParams:
        turnZ: 296
      name: channel
      to: "//pub/std/metric/m:m14-thru-2.5"
      toInstance: top-inner-1

  - part: motion/shaft_8mmREX_72mm
    name: worm-shaft
    connect:
      with: 8mmREX-shaft
      withInstance: clip
      name: bearing-worm-1
      to: 8mmREX-thru-5
      toInstance: clean-side

  - part: motion/shaft_8mmREX_72mm_clip
    name: worm-shaft-clip
    connect:
      with: 8mmREX-thru-0.7
      withInstance: side1
      name: worm-shaft
      to: 8mmREX-shaft
      toInstance: groove

  - part: hardware/spacer_steel_8mm_4mm
    name: spacer-steel
    connect:
      with: "//pub/std/metric/m:m8-thru-4"
      withInstance: side0
      name: bearing-worm-1
      to: 8mmREX-thru-5
      toInstance: flange-side

  # Against that spacer, which centres it on the gear
  - part: motion/worm_8mmREX
    name: worm
    connect:
      with: 8mmREX-thru-33
      withInstance: side0
      name: worm-shaft
      to: 8mmREX-shaft
      toInstance: clip-side
      toParams:
        moveZ: 13
      # Meshing with the gear. The two models are not exact conjugates of each
      # other, so their flanks share about 1mm^3 however the worm is turned.
      interferes: gear

  - part: hardware/spacer_plastic_8mm_1mm
    name: spacer-plastic-1
    connect:
      with: "//pub/std/metric/m:m8-thru-1"
      withInstance: side0
      name: worm
      to: 8mmREX-thru-33
      toInstance: side1

  - part: hardware/spacer_plastic_8mm_1mm
    name: spacer-plastic-2
    connect:
      with: "//pub/std/metric/m:m8-thru-1"
      withInstance: side0
      name: spacer-plastic-1
      to: "//pub/std/metric/m:m8-thru-1"
      toInstance: side1

  # Screwed to both walls of the channel, near the open side of it
  - part: structure/mount_quad_block
    name: mount
    connect:
      with: "//pub/std/metric/m:m-threaded-thru-depth;depth=8.5,size=4"
      withInstance: side0-0
      name: channel
      to: "//pub/std/metric/m:m4-thru-2.5"
      toInstance: left-inner-2-1-10

  - part: hardware/screw_m4_0.7mm_12mm
    name: screw-0-0
    connect:
      withParams:
        moveZ: 2.5
      name: mount
      # TODO(clairbee): Autodetect the interface by the instance name
      to: "//pub/std/metric/m:m-threaded-thru-depth;depth=8.5,size=4"
      toInstance: side0-0

  - part: hardware/screw_m4_0.7mm_12mm
    name: screw-0-1
    connect:
      withParams:
        moveZ: 2.5
      name: mount
      to: "//pub/std/metric/m:m-threaded-thru-depth;depth=8.5,size=4"
      toInstance: side0-1

  - part: hardware/screw_m4_0.7mm_12mm
    name: screw-2-0
    connect:
      withParams:
        moveZ: 2.5
      name: mount
      to: "//pub/std/metric/m:m-threaded-thru-depth;depth=8.5,size=4"
      toInstance: side2-0

  - part: hardware/screw_m4_0.7mm_12mm
    name: screw-2-1
    connect:
      withParams:
        moveZ: 2.5
      name: mount
      to: "//pub/std/metric/m:m-threaded-thru-depth;depth=8.5,size=4"
      toInstance: side2-1

  # In the mount, flush with its front. That leaves 2.5mm between its flange
  # and the worm, for three 1mm spacers: the third one is squeezed in, to
  # press the stack together (see 'spacer-plastic-3' below).
  - part: motion/bearing_flanged_8mmREX
    name: bearing-worm-2
    connect:
      with: 8mmREX-thru-5
      withInstance: flange-side
      name: worm-shaft
      to: 8mmREX-shaft
      toInstance: clip-side
      toParams:
        moveZ: 48.5

  # Against the flange of the bearing, and pressed 0.5mm into the spacer below
  # it: the stack is 0.5mm longer than the space it is in, on purpose, so that
  # it holds the worm tight.
  # TODO: say this with something better than 'interferes', once PartCAD has
  # a way to say that a part is compressed.
  - part: hardware/spacer_plastic_8mm_1mm
    name: spacer-plastic-3
    connect:
      with: "//pub/std/metric/m:m8-thru-1"
      withInstance: side0
      name: bearing-worm-2
      to: 8mmREX-thru-5
      toInstance: flange-side
      interferes: spacer-plastic-2

  - part: hardware/spacer_plastic_8mm_1mm
    name: spacer-drive-worm
    connect:
      with: "//pub/std/metric/m:m8-thru-1"
      withInstance: side0
      name: bearing-worm-2
      to: 8mmREX-thru-5
      toInstance: clean-side

  # Against that spacer
  - part: motion/hub_sonic_8mmREX
    name: gear-drive-worm-hub
    connect:
      with: 8mmREX-thru-10
      withInstance: flat
      name: worm-shaft
      to: 8mmREX-shaft
      toInstance: clip-side
      toParams:
        moveZ: 54.5
